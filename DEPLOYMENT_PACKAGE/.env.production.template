# =============================================================================
# CareFlow AI - Production Environment
# =============================================================================
#
# IMPORTANT: Copy this file to .env.production and replace the placeholder values
# NEVER commit .env.production to version control!
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================

# Domain configuration
DOMAIN=careflowAI.YOUR-DOMAIN.COM
APP_URL=https://careflowAI.YOUR-DOMAIN.COM
API_URL=https://api.careflowAI.YOUR-DOMAIN.COM

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL (Production - will be set by docker-compose)
DATABASE_URL=postgresql://careflow:YOUR-DB-PASSWORD@postgres:5432/careflow_prod

# Redis (Production - will be set by docker-compose)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Security (NEVER USE THESE IN PRODUCTION!)
# =============================================================================

# Generate secret keys with:
# python -c "import secrets; print(secrets.token_hex(32))"
# openssl rand -base64 32

SECRET_KEY=CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-USE-OPENSSL-RAND-BASE64-32
SECRET_KEY_REFRESH=CHANGE-THIS-REFRESH-SECRET-KEY-IN-PRODUCTION

# AES-256 encryption key for PHI (32 bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGE-THIS-ENCRYPTION-KEY-32-BYTES-HEX-EXACTLY

# =============================================================================
# AI Provider Configuration
# =============================================================================

# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Or Anthropic Claude API Key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for frontend
CORS_ORIGINS=https://careflowAI.YOUR-DOMAIN.COM,https://YOUR-DOMAIN.COM

# =============================================================================
# Email Configuration (Optional)
# =============================================================================

# SMTP Settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@YOUR-DOMAIN.COM
SMTP_FROM_NAME=CareFlow AI

# =============================================================================
# Application Settings
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# =============================================================================
# Monitoring & Logging
# =============================================================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Frontend Configuration
# =============================================================================

NEXT_PUBLIC_APP_URL=https://careflowAI.YOUR-DOMAIN.COM
NEXT_PUBLIC_API_URL=https://api.careflowAI.YOUR-DOMAIN.COM
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# =============================================================================
# Backup Configuration
# =============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
