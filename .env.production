# =============================================================================
# CareFlow AI - Production Environment Configuration
# =============================================================================
# For Railway Cloud Deployment
# Domain: careflowai.veraldlabs.co.uk

# =============================================================================
# Application
# =============================================================================
APP_NAME=CareFlow AI
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_URL=https://careflowai.veraldlabs.co.uk
API_URL=https://api.careflowai.veraldlabs.co.uk

# =============================================================================
# Database (Railway provides DATABASE_URL automatically)
# =============================================================================
# DATABASE_URL will be set by Railway: ${{Postgres.DATABASE_URL}}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis (Railway provides REDIS_URL automatically)
# =============================================================================
# REDIS_URL will be set by Railway: ${{Redis.REDIS_URL}}
REDIS_CACHE_URL=${{Redis.REDIS_URL}}
REDIS_AGENT_STATE_URL=${{Redis.REDIS_URL}}

# =============================================================================
# Security (Generate these with: python -c "import secrets; print(secrets.token_urlsafe(32))" )
# =============================================================================
# IMPORTANT: Replace these with your own generated values in Railway dashboard!
SECRET_KEY=REPLACE_WITH_RAILWAY_GENERATED_VALUE
SECRET_KEY_REFRESH=REPLACE_WITH_RAILWAY_GENERATED_VALUE

# AES-256 encryption key for PHI at rest (32 bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=REPLACE_WITH_RAILWAY_GENERATED_VALUE

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# =============================================================================
# AI/LLM Configuration
# =============================================================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# OpenAI API Key (REQUIRED for AI features)
# Add your key in Railway dashboard: OPENAI_API_KEY=sk-...
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Vector Database (pgvector)
VECTOR_DIMENSIONS=1536
VECTOR_SIMILARITY_THRESHOLD=0.75

# =============================================================================
# Email (Optional - for notifications)
# =============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM=noreply@veraldlabs.co.uk
SMTP_FROM_NAME=CareFlow AI
SMTP_USE_TLS=true

# =============================================================================
# Storage (Optional - for document uploads)
# =============================================================================
# S3-compatible storage for documents and files
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=careflow-documents

# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_TRIAGE_ENABLED=true
FEATURE_AI_SCRIBE_ENABLED=true
FEATURE_AI_BILLING_ENABLED=true
FEATURE_AUTO_SCHEDULING_ENABLED=true
FEATURE_TELEHEALTH_ENABLED=false

# =============================================================================
# Compliance
# =============================================================================
COMPLIANCE_RETENTION_DAYS=2555  # 7 years
COMPLIANCE_AUDIT_LOG_RETENTION_DAYS=2555
COMPLIANCE_ANONYMIZE_AFTER_RETENTION=true

# =============================================================================
# Frontend Environment Variables (Add these to Frontend service in Railway)
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://careflowai.veraldlabs.co.uk
NEXT_PUBLIC_API_URL=https://api.careflowai.veraldlabs.co.uk
NEXT_PUBLIC_ENABLE_ANALYTICS=false
