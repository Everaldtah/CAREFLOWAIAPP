# =============================================================================
# CareFlow AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Application
# =============================================================================
APP_NAME=CareFlow AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://careflow:careflow_password@localhost:5432/careflow_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_AGENT_STATE_URL=redis://localhost:6379/2

# =============================================================================
# Security
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=t+ea/Zx/ZVY8BpUXi1zklzR9ynxxEVd2DpzHTDo8AXI=
SECRET_KEY_REFRESH=Xj8kN2mP5qR7sT9vW3yY5aB8cD6eF1gH4iJ2kL0nP=

# AES-256 encryption key for PHI at rest (32 bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=37f948bb01ec287bcec3bad7d31eadcbe4be5043139ab78e69d5bc5221026d9d

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# =============================================================================
# AI/LLM Configuration
# =============================================================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Vector Database (pgvector)
VECTOR_DIMENSIONS=1536
VECTOR_SIMILARITY_THRESHOLD=0.75

# =============================================================================
# Email
# =============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM=noreply@careflow.ai
SMTP_FROM_NAME=CareFlow AI
SMTP_USE_TLS=true

# =============================================================================
# Storage
# =============================================================================
# S3-compatible storage for documents and files
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=careflow-documents

# =============================================================================
# EHR Integration
# =============================================================================
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_FHIR_URL=

CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=
CERNER_FHIR_URL=

# =============================================================================
# OAuth/Social
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=careflow-ai

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_TRIAGE_ENABLED=true
FEATURE_AI_SCRIBE_ENABLED=true
FEATURE_AI_BILLING_ENABLED=true
FEATURE_AUTO_SCHEDULING_ENABLED=true
FEATURE_TELEHEALTH_ENABLED=false

# =============================================================================
# Compliance
# =============================================================================
COMPLIANCE_RETENTION_DAYS=2555  # 7 years
COMPLIANCE_AUDIT_LOG_RETENTION_DAYS=2555
COMPLIANCE_ANONYMIZE_AFTER_RETENTION=true

# =============================================================================
# Multi-tenancy
# =============================================================================
TENANT_ISOLATION_LEVEL=database
MAX_CLINICS_PER_TENANT=100
MAX_USERS_PER_CLINIC=500

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_ANALYTICS=false
